<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <PlatformTarget>x64</PlatformTarget>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <RootNamespace>SlotsInstaller</RootNamespace>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Slotsloader Manager</AssemblyName>
    <StartupObject>SlotsInstaller.Program</StartupObject>
    <ApplicationManifest>src\app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\slotsloader.ico</ApplicationIcon>
    <AppConfig>src\app.config</AppConfig>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <Optimize>true</Optimize>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ConsoleBuild)' == 'true'">
    <OutputType>Exe</OutputType>
    <AssemblyName>Slotsloader CLI</AssemblyName>
    <StartupObject>SlotsInstaller.CommandLineProgram</StartupObject>
    <DefineConstants>$(DefineConstants);CLI</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" /><Reference Include="System.Core" />
    <Reference Include="System.Windows.Forms" /><Reference Include="System.Drawing" />
    <Reference Include="Accessibility" /><Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression" /><Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" /><Reference Include="System.Security" />
    <Reference Include="Microsoft.VisualBasic" />
    <Compile Include="src\*.cs" />
    <EmbeddedResource Include="assets\slotsloader.ico"><LogicalName>SlotsInstaller.AppIcon</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="assets\loader-pin.json"><LogicalName>SlotsInstaller.LoaderPin.json</LogicalName></EmbeddedResource>
    <None Include="assets\slotsloader.png" /><None Include="assets\README.md" />
    <None Include="src\app.config" /><None Include="src\app.manifest" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
